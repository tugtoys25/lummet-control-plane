{
  "name": "lummet-control-plane",
  "private": true,
  "type": "module",
  "description": "This package.json exists ONLY to provide a standard `npm test` entry point for the zero-dependency security/RBAC test suite added under /test. Mirrors the tenant repo's convention: tests run against Node's built-in test runner (node:test) and built-in node:sqlite (Node 22+), not against any installed package. The Worker itself has no build step and is deployed as plain JS via wrangler, same as before this file existed.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node scripts/test-by-file.mjs",
    "package:phase": "node scripts/package-phase.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:phase2": "node scripts/phase-gate.mjs --phase 2",
    "catalog:check": "node scripts/stripe-sync.mjs --offline",
    "test:serial": "node scripts/test-by-file.mjs",
    "stripe:webhook:plan": "node scripts/stripe-webhook-config.mjs",
    "stripe:webhook:verify": "node scripts/stripe-config-verify.mjs",
    "stripe:clock:dry-run": "node scripts/stripe-clock-suite.mjs",
    "go-live:evidence": "node scripts/go-live-evidence.mjs",
    "check:phase4": "node scripts/phase4-gate.mjs",
    "check:phase5": "node scripts/phase5-gate.mjs",
    "check:lockfiles": "node scripts/lockfile-check.mjs",
    "regen:lockfiles": "node scripts/regenerate-lockfiles.mjs",
    "check:release-owner": "node scripts/check-release-owner.mjs"
  },
  "version": "2.6.0",
  "devDependencies": {
    "wrangler": "4.46.0"
  }
}
