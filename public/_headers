# Applied by the assets layer to files it serves directly (wrangler.jsonc: run_worker_first excludes /static/*).
# css/js are always referenced as /static/css|js/<file>?v=<token> (worker/perf/asset-version.js), so a new release is a
# new URL and these can be cached for a year.
/static/css/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/static/js/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/static/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff
/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
