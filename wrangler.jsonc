{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lummet-control-plane",
	"main": "worker/index.js",
  "preview_urls": false,
	"compatibility_date": "2026-01-01",
	"placement": { "mode": "smart" },
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Public website assets: templates (public/templates/**) are read by the
	// Worker through this binding; only /static/* is ever served to visitors
	// (worker/public-site/router.js), so templates are never exposed as URLs.
	// run_worker_first sends every request through the Worker EXCEPT /static/* (css/js/images, served straight by the
	// assets layer with the cache policy in public/_headers: no Worker hop). Everything else goes through the Worker, which is
	// required because the SaaS portal, staff console and APIs share this origin.
	"assets": {
		"binding": "ASSETS",
		"directory": "./public",
		"run_worker_first": ["/*", "!/static/*"]
	},
	// Bind this Worker's own, independent D1 database.
	// This database holds ONLY control-plane metadata:
	// the tenant registry, encrypted credential references,
	// capability/health cache, Lummet's own admin
	// accounts/sessions, AND (as of the SaaS merge) every
	// customer/organization/billing/provisioning/domain/
	// deployment/job table — see migrations 0006-0017. It
	// never holds tenant content (casinos, reviews, news,
	// pages, tenant end-users, etc.) — that stays in each
	// tenant's own D1, reached only through the tenant
	// Super API (client.js), never directly (rule #22).
	"d1_databases": [
		{
			"binding": "LUMMET_DB",
			"database_name": "lummet-control-plane-db",
			"database_id": "7e73855b-a939-43bf-8e64-b38c4d4bce72"
		}
	],
	// Workers AI binding for the AI management chat (worker/ai/intent.js).
	// Same binding name/pattern the tenant repo already uses
	// (en/worker/ai/*.js -> env.AI.run(...)) -- reused here rather than
	// introducing a separate provider/dependency. If this binding is
	// absent, intent.js falls back to a deterministic keyword parser
	// (see intent.js's fallbackIntent) instead of failing closed.
	"ai": {
		"binding": "AI"
	},
	// R2 bucket for tenant backups (master prompt section 23). Optional —
	// without it, backups.js fails closed with "backup_storage_not_configured"
	// rather than pretending to back anything up. Create with:
	//   wrangler r2 bucket create lummet-backups
	//
	// R2 bucket for published tenant template releases (roadmap 0.1) — the
	// shared build every newly-provisioned site auto-deploys. Optional in
	// the same fail-closed sense: without it, a new site still provisions
	// real infrastructure but honestly stops at "provisioned" instead of
	// "active". Create with:
	//   wrangler r2 bucket create lummet-tenant-templates
	"r2_buckets": [
		{
			"binding": "BACKUPS",
			"bucket_name": "lummet-backups"
		},
		{
			"binding": "TENANT_TEMPLATES",
			"bucket_name": "lummet-tenant-templates"
		}
	],
	// Secrets (set via `wrangler secret put`, never here):
	//
	//   CREDENTIAL_KEK          — base64-encoded 32-byte AES-GCM key.
	//                             Encrypts at rest: tenant Super API
	//                             HMAC secrets, webhook signing secrets,
	//                             and TOTP (2FA) secrets. Required.
	//   WEB_SEARCH_API_KEY — optional. Only used by the AI chat's
	//                     "/lu-agent <goal>" mode (worker/ai/web-search.js)
	//                     when it decides a web search would help.
	//                     Without this set, agent mode still works for
	//                     reads/writes-preview -- web_search just reports
	//                     "not configured" instead of a result, and the
	//                     agent explains that rather than inventing one.
	//                     Defaults to the Brave Search API's request shape;
	//                     point WEB_SEARCH_ENDPOINT at a different provider
	//                     if needed.
	//
	//   STRIPE_SECRET_KEY       — Stripe secret key (sk_live_... or
	//                             sk_test_...). Required for billing
	//                             (Phase 2) — checkout, cancel, resume,
	//                             change-plan all fail without it. If
	//                             unset, billing.js's stripeProvider
	//                             returns a clear "billing not
	//                             configured" error rather than a fake
	//                             success (rule #5 — no fake billing).
	//   STRIPE_WEBHOOK_SECRET   — Stripe webhook signing secret
	//                             (whsec_...), from the endpoint you
	//                             create for POST
	//                             /api/billing/webhook/stripe. Required
	//                             for subscription state to stay in
	//                             sync with Stripe (renewals, payment
	//                             failures, cancellations).
	//
	//   CF_API_TOKEN            — Cloudflare API token used to
	//                             provision per-site D1/KV/R2/Worker
	//                             resources and custom-hostname SSL
	//                             (Phases 3-4, infra-cloudflare.js).
	//                             Needs: Account: Workers Scripts:Edit,
	//                             D1:Edit, Workers KV Storage:Edit,
	//                             Workers R2 Storage:Edit; Zone: SSL
	//                             and Certificates:Edit (for custom
	//                             hostnames) on the zone named by
	//                             CF_ZONE_ID below. If unset,
	//                             provisioning jobs fail at the
	//                             "create Cloudflare resources" step
	//                             with an explicit error, rather than
	//                             pretending a site was provisioned.
	//   CF_ACCOUNT_ID           — the Cloudflare account ID that owns
	//                             the resources CF_API_TOKEN creates.
	//   CF_ZONE_ID              — the zone ID of the domain used for
	//                             SSL-for-SaaS custom hostnames
	//                             (Phase 4 domain verification/SSL) AND for
	//                             the per-site routes that make each
	//                             site's platform hostname reachable.
	//                             The token also needs Zone: Workers
	//                             Routes: Edit here. See DEPLOYMENT.md,
	//                             "How a new site becomes reachable".
	//
	//   WEBAUTHN_RP_ID          — the Relying Party ID for passkeys
	//                             (Phase 7), e.g. "app.lummet.io".
	//                             Must exactly match the hostname the
	//                             customer portal is served from — a
	//                             mismatch fails every ceremony by
	//                             design (webauthn.js checks this).
	//   EMAIL_PROVIDER          — set to "resend" to enable transactional
	//                             email (signup verification, password
	//                             reset, team invitations). Unset means
	//                             those messages stay queued in the
	//                             email_outbox table forever and are
	//                             never delivered — check
	//                             /platform/saas/email for a stuck queue.
	//   RESEND_API_KEY          — Resend API key, required with the above.
	//   EMAIL_FROM              — e.g. "Lummet <no-reply@yourdomain.com>";
	//                             must be a domain verified in Resend.
	//
	//   WEBAUTHN_ORIGIN         — the full origin passkeys are bound
	//                             to, e.g. "https://app.lummet.io".
	//                             Falls back to a same-origin default
	//                             computed from the request only in
	//                             local/dev use; set explicitly in
	//                             production.
	//
	// Optional vars:
	//   CONTACT_EMAIL           — if set, shown on the public homepage's
	//                             "Get in Touch" section as a mailto link.
	//                             Left unset by default; the public site
	//                             shows a neutral fallback instead of an
	//                             invented address until this is configured.
	//   PLATFORM_DOMAIN_SUFFIX  — the placeholder domain a newly
	//                             provisioned site's tenant registry
	//                             row is given before a real custom
	//                             domain is attached (Phase 3). Default:
	//                             "sites.lummet.app" — set this to a
	//                             domain you actually control.
	//   CF_WORKERS_DEV_SUBDOMAIN — the workers.dev subdomain used as
	//                             the deployment health-check target
	//                             when a site has no verified custom
	//                             domain yet (Phase 4). Default: "workers".
	//
	// Routes / custom domain for the master hostname are configured
	// separately in the Cloudflare dashboard or via `routes` here.
	// Deliberately NOT using any hostname starting with "lummet."
	// to avoid any collision with a tenant's lummet.<host> AI
	// assistant subdomain — see DEPLOYMENT.md, "Choosing the master
	// hostname".
	// PORTAL_BASE_URL is a var, not a secret (it is not sensitive), but it
	// gates every emailed link: without it, queueEmail() refuses to queue
	// verification/reset/invitation messages at all rather than emailing a
	// broken or (worse) attacker-controlled link built from a request Host
	// header. Set it to the customer portal's real origin, e.g.
	// "https://app.yourdomain.com".
	"workers_dev": true,
	"routes": [{ "pattern": "lummet.com", "custom_domain": true }],
	"queues": { "producers": [{ "binding": "JOB_QUEUE", "queue": "lummet-jobs" }], "consumers": [{ "queue": "lummet-jobs", "max_batch_size": 1, "max_retries": 5, "dead_letter_queue": "lummet-jobs-dlq" }] },
	"triggers": { "crons": ["*/5 * * * *", "0 2 * * *", "0 7 * * 1"] },
	"vars": {
		// Turnstile on the staff sign-in: off | on. Needs TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY, else it stays off. Break-glass: set to "off" and deploy.
		"STAFF_TURNSTILE_REQUIRED": "on",
		"ENVIRONMENT": "test",
		"OUTBOUND_DNS_CHECK": "on",
		// Billing lifecycle (docs/CHANGES_PHASE_1.md). BILLING_ENFORCE is the rollout flag: off, then shadow, then enforce.
		// Card-required trial: off | on. See worker/billing-config.js (cardRequiredTrial).
		"CARD_REQUIRED_TRIAL": "off",
		// Plans listed under the /demo form: off | on (worker/public-site/demo-plans.js). DEMO_PLANS_PRODUCT (optional product id) picks the family shown.
		"DEMO_PAGE_PLANS": "on",
		"BILLING_ENFORCE": "enforce",
		"BILLING_SUSPEND_SITES": "shadow",
		"BILLING_EMAILS": "on",
		"REVENUE_METRICS": "on",
		"REVENUE_ANALYTICS": "on",
		// Organization security policy (6.4A): off, shadow (report only), enforce (org-wide 2FA blocks members without it). Stays off until the owner answers OPEN_ITEMS_v2.6.0.9.md.
		"ORG_SECURITY_POLICY": "enforce",
		"CUSTOMER_SESSION_ADMIN": "on",
		"CUSTOMER_AUDIT_CSV": "on",
		// Customer authenticator enrollment page at /app/security/2fa (release 2.6.0.16): off (default, 404) or on.
		"CUSTOMER_2FA_ENROLL_PAGE": "on",
		// Password hash format for NEW hashes (release 2.6.0.17): legacy (default) or v2. v2 also upgrades old hashes on login.
		// Do not set v2 until 2.6.0.17 or later is the oldest build you could roll back to: older builds cannot verify v2 hashes.
		"PASSWORD_HASH_FORMAT": "v2",
		// Synthetic monitors (6.5A): off (default; nothing probed), shadow (probe and record, never page), on (a failing monitor pages through the alert channel). Needs the monitor account and canary settings in docs/SYNTHETIC_MONITORS.md; secrets (SYNTHETIC_SIGNIN_PASSWORD) are Worker secrets, never vars.
		"SYNTHETIC_MONITORS": "shadow",
		// IP allowlist (6.4C): off, shadow (log would-deny, nothing blocked), enforce. Also needs the plan entitlement security.ip_allowlist.enabled (granted to no plan). Stays off until OPEN_ITEMS_v2.6.0.11.md is answered.
		"ORG_IP_ALLOWLIST": "off",
		// SSO requirement (6.4C): a stub. off or shadow only; never enforced because no identity provider is named.
		"ORG_SSO_REQUIREMENT": "off",
		// Public trust pages (6.2A): off, shadow (review, noindex), on. STATUS_PROVIDER_URL, SECURITY_CONTACT and SECURITY_TXT_EXPIRES are owner values, set per environment.
		"PUBLIC_TRUST_PAGES": "shadow",
		// Legal pages (6.2B): off, draft (watermarked DRAFT FOR COUNSEL, noindex), on (only with recorded counsel approval per market). See docs/CONFIGURATION.md.
		"PUBLIC_LEGAL_PAGES": "off",
		// Edge rate limiting (6.3A). RATE_LIMIT_RETRY_AFTER: off|on. The CF_WAF_* values and WAF_THRESHOLDS_CONFIRMED are owner inputs [OPEN]; see docs/WAF_RATE_LIMITS.md.
		"RATE_LIMIT_RETRY_AFTER": "on",
		// "CF_WAF_ZONE_ID": "68a8b498fb91401bc287803ebb0690c5",  // off in production; set in staff platform settings (frees a Worker variable slot)
		// "CF_WAF_MAX_RULES": "",  // off in production; set in staff platform settings (frees a Worker variable slot)
		// "CF_WAF_ALLOWED_PERIODS": "",  // off in production; set in staff platform settings (frees a Worker variable slot)
		// "CF_WAF_MAX_TIMEOUT": "",  // off in production; set in staff platform settings (frees a Worker variable slot)
		// "WAF_THRESHOLDS_CONFIRMED": "no",  // off in production; set in staff platform settings (frees a Worker variable slot)
		// HSTS preload (6.3C): off (default; header is max-age=31536000; includeSubDomains) | on (adds preload, two-year max-age; hard to undo, covers every subdomain). "on" also needs HSTS_PRELOAD_APPROVED=yes [OPEN owner approval]; see docs/HSTS_PRELOAD.md.
		"HSTS_PRELOAD": "off",
		// "HSTS_PRELOAD_APPROVED": "no",  // off in production; uncomment when needed (frees a Worker variable slot)
		// CSP violation-report collection (6.3C): basic (default, the 2.6.0.7 behaviour) | full (Reporting API, scrubbed fields, flood cap). CSP_MODE stays report-only here; see docs/CSP_REPORTING.md.
		"CSP_REPORT_MODE": "full",
		// Secret encryption (Phase K). CREDENTIAL_KEK_STRICT: off (default) | on (the runtime refuses a CREDENTIAL_KEK that is not base64 of exactly 32 non-trivial bytes; turn on only after config-check passes with the real key). CREDENTIAL_ENCRYPTION_FORMAT: v1 (default) | v2 (new secrets are bound to their table, row and column; v1 and v2 are always readable; run the staff key-rotation page to upgrade existing rows). See docs/KEY_CUSTODY.md.
		"CREDENTIAL_KEK_STRICT": "off",
		"CREDENTIAL_ENCRYPTION_FORMAT": "v1",
		// 2.6.1.6. API_ENTITLEMENT: off (default) | shadow (log only) | enforce (a plan without api.enabled cannot create or use API keys; a payment lapse does not end key reads).
		// ORG_2FA_PASSKEY_COUNTS: off (default) | on (a passkey sign-in with user verification satisfies an organization's 2FA requirement; needs migration 0077).
		// ORG_2FA_SCOPE: any_org (default, one organization's requirement restricts the whole session) | active_org (it restricts only that organization).
		"API_ENTITLEMENT": "off",
		"ORG_2FA_PASSKEY_COUNTS": "off",
		"ORG_2FA_SCOPE": "any_org",
		// Error tracking (6.3C): off (default) | shadow (build + scrub + log a summary, send nothing) | on (send scrubbed events to SENTRY_DSN, a Worker SECRET set with `wrangler secret put`, never a var). "on" also needs ERROR_TRACKING_APPROVED=yes [OPEN owner approval, tracker as sub-processor]; see docs/ERROR_TRACKING.md.
		"ERROR_TRACKING": "off",
		"ERROR_TRACKING_APPROVED": "no",
		// Log redaction (6.3C): off (default) | on (scrub emails, IPs, tokens, secrets from console output, and so from Logpush). Turn on before enabling Logpush or the audit stream; see docs/LOGPUSH.md.
		"LOG_REDACTION": "on",
		// Audit stream (6.3C): off (default) | on (each audit row also written once as a scrubbed log line, because Logpush cannot read D1). "on" requires LOG_REDACTION=on.
		"AUDIT_LOG_STREAM": "on",
		// Cloudflare Access JWT for /platform/* and /api/platform/* (6.3B): off (default) | shadow (log only) | enforce (refuse without a valid Access JWT; fails closed).
		// CF_ACCESS_ISSUER (https://<team>.cloudflareaccess.com) and CF_ACCESS_AUD (application AUD tag) are owner inputs [OPEN] and are required once the mode is not off; see docs/CLOUDFLARE_ACCESS.md.
		"PLATFORM_ACCESS_JWT_MODE": "off",
		// "CF_ACCESS_ISSUER": "",  // off in production; uncomment when needed (frees a Worker variable slot)
		// "CF_ACCESS_AUD": "",  // off in production; uncomment when needed (frees a Worker variable slot)
		"REVENUE_REPORTING_CURRENCY": "USD",
		"STRIPE_API_VERSION": "2024-06-20",
		// Checkout Sessions only: the Stripe account has Managed Payments on, which needs 2025-03-31.basil or newer.
		"STRIPE_CHECKOUT_API_VERSION": "2025-03-31.basil",
		"BILLING_TRIAL_DAYS_DEFAULT": "7",
		"BILLING_GRACE_DAYS": "14",
		"BILLING_RESTRICTED_DAYS": "7",
		"BILLING_SUSPENDED_DAYS": "30",
		"BILLING_REMINDER_DAYS": "3,1",
		"PLATFORM_DOMAIN_SUFFIX": "genteelisms.com",
		"CONTACT_EMAIL": "elijul@proton.me",
		"PORTAL_BASE_URL": "https://lummet.com",
		"EMAIL_PROVIDER": "resend",
		"EMAIL_FROM": "Lummet <no-reply@lummet.com>",
		"PAYMENT_GATEWAYS": "nowpayments",
		"CF_WORKERS_DEV_SUBDOMAIN": "tugtoys25",
                "TURNSTILE_SITE_KEY": "0x4AAAAAAFu7XNvU-gnTjL26",
		"WEBAUTHN_RP_ID": "lummet.com",
		"WEBAUTHN_ORIGIN": "https://lummet.com"
	},
	// NOTE: scheduled work. "triggers.crons" declares three Cron Triggers (Workers Paid plan: Cron Triggers, Queues and
	// the PBKDF2 CPU budget all need it; verify in the Cloudflare dashboard). scheduled() branches on event.cron:
	//   "*/5 * * * *"  the tick: health checks, outbox, jobs, webhook retries, alerts, backups, erasure, rollouts and the
	//                  billing lifecycle sweep. Every run is recorded in scheduler_ticks; alert `cron_not_running`
	//                  fires if none is recorded for 20 minutes.
	//   "0 2 * * *"    daily  (reserved for reconciliation and snapshots in later phases)
	//   "0 7 * * 1"    weekly (reserved for the internal revenue digest)
	// An unknown cron expression runs the tick, so changing a trigger never stops the existing sweep. Keep
	// ALERT_CHECK_TOKEN and an external pinger on POST /api/ops/alert-check as a second path (docs/ALERTING.md).
	// Provisioning and deployment jobs do NOT depend on a cron: they run via ctx.waitUntil() when started.

  "env": {
    "staging": {
      "name": "lummet-control-plane-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "staging.lummet.com", "custom_domain": true }],
      "d1_databases": [{"binding":"LUMMET_DB","database_name":"lummet-control-plane-staging-db","database_id":"00000000-0000-0000-0000-000000000001"}],
      "r2_buckets": [{"binding":"BACKUPS","bucket_name":"lummet-backups-staging"},{"binding":"TENANT_TEMPLATES","bucket_name":"lummet-tenant-templates-staging"}],
      "queues": {"producers":[{"binding":"JOB_QUEUE","queue":"lummet-jobs-staging"}],"consumers":[{"queue":"lummet-jobs-staging","max_batch_size":1,"max_retries":5,"dead_letter_queue":"lummet-jobs-staging-dlq"}]},
      "triggers": {"crons":["*/5 * * * *"]},
      "vars": {"STAFF_TURNSTILE_REQUIRED":"on","ENVIRONMENT":"staging","BILLING_ENFORCE":"enforce","BILLING_EMAILS":"on","BILLING_SUSPEND_SITES":"enforce","STRIPE_TAX_ENABLED":"false","STRIPE_API_VERSION":"2024-06-20","REVENUE_METRICS":"on","REVENUE_ANALYTICS":"on","CREDENTIAL_KEK_STRICT":"off","CREDENTIAL_ENCRYPTION_FORMAT":"v1","API_ENTITLEMENT":"off","ORG_2FA_PASSKEY_COUNTS":"off","ORG_2FA_SCOPE":"any_org","ORG_SECURITY_POLICY":"enforce","ORG_IP_ALLOWLIST":"shadow","ORG_SSO_REQUIREMENT":"shadow","CUSTOMER_SESSION_ADMIN":"on","CUSTOMER_AUDIT_CSV":"on","CUSTOMER_2FA_ENROLL_PAGE":"on","PASSWORD_HASH_FORMAT":"v2","SYNTHETIC_MONITORS":"shadow","PUBLIC_TRUST_PAGES":"on","PUBLIC_LEGAL_PAGES":"draft","RATE_LIMIT_RETRY_AFTER":"on","CSP_REPORT_MODE":"full","LOG_REDACTION":"on","AUDIT_LOG_STREAM":"on","ERROR_TRACKING":"shadow","PLATFORM_ACCESS_JWT_MODE":"shadow","BILLING_TRIAL_DAYS_DEFAULT":"7","BILLING_GRACE_DAYS":"14","BILLING_RESTRICTED_DAYS":"7","BILLING_SUSPENDED_DAYS":"30","BILLING_REMINDER_DAYS":"3,1","EMAIL_PROVIDER":"resend","EMAIL_FROM":"Lummet <no-reply@lummet.com>","PLATFORM_DOMAIN_SUFFIX":"staging.sites.lummet.app","PORTAL_BASE_URL":"https://staging.lummet.com","CF_WORKERS_DEV_SUBDOMAIN":"staging","WEBAUTHN_RP_ID":"staging.lummet.com","WEBAUTHN_ORIGIN":"https://staging.lummet.com"}
    }
  }
}
